{
  "manifest_version": 3,
  "name": "wing 连接器",
  "version": "1.1.0",
  "description": "把翼课网登录态与真实请求头交给本机的 wing 命令行。只连 127.0.0.1，必须你手动点。",
  "permissions": ["cookies", "storage", "webRequest"],
  "host_permissions": [
    "*://*.ekwing.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "wing 连接器"
  }
}
